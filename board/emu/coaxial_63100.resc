:name: Coaxial 63100
:description: The application image on an emulated STM32H753, its console on a TCP port.

$name?="coaxial_63100"
$elf?=@build/Debug/coaxial_63100.elf
$port?=3456
$console?="console"
$vtor?=0x30000000

include @board/emu/Coaxial63100_ADC.cs
include @board/emu/Coaxial63100_AFE.cs
include @board/emu/RS485_Transceiver.cs
include @board/emu/UART_Line.cs
include @board/emu/RS485_Adapter.cs
include @board/emu/Coaxial63100_A1335.cs
include @board/emu/Coaxial63100_BNO085.cs
include @board/emu/Coaxial63100_TIM1.cs
include @board/emu/Coaxial63100_Plant.cs
include @board/emu/FastDWT.cs
using sysbus
mach create $name
machine LoadPlatformDescription @board/emu/coaxial_63100.repl
machine UnregisterFromParent sysbus.adcM1S2
machine UnregisterFromParent sysbus.adc3
machine UnregisterFromParent sysbus.dwt
machine UnregisterFromParent sysbus.timer1
machine LoadPlatformDescription @board/emu/coaxial_63100_board.repl
machine LoadPlatformDescription @board/emu/coaxial_63100_afe.repl

emulation CreateServerSocketTerminal $port $console false
connector Connect sysbus.gpioPortB.consoleLine $console

macro reset
"""
    sysbus LoadELF $elf
    cpu VectorTableOffset $vtor
"""
runMacro $reset
