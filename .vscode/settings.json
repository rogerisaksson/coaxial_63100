{
    // A terminal profile, so the local model is one click away in the docked
    // panel rather than a command to remember and type. Terminal panel, the
    // dropdown next to +, "Board chat": it opens there, beside the build
    // output, and closing it hands the graphics memory back.
    //
    // A profile rather than a task because a task terminal is a task's
    // terminal - it is read-only once the command exits, and this one is a
    // prompt you type into. Both exist; the task is for one question
    // (Ctrl+Shift+B), the profile for a conversation.
    "terminal.integrated.profiles.windows": {
        "Board chat": {
            "path": "powershell.exe",
            "args": [
                "-NoExit",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\host\\board_chat.ps1"
            ],
            "icon": "circuit-board",
            "color": "terminal.ansiGreen"
        },
        "PowerShell": { "source": "PowerShell", "icon": "terminal-powershell" }
    },
    // The render's glow ramp is dim cyan on black by design - the exporter's
    // '.' dots sit at 90 luma. VS Code's default of 4.5 lifts every colour
    // under that contrast to exactly 4.5:1, and at y45 that is 72% of the
    // cells at ONE brightness: the surface texture and the whole dark half
    // of the ramp gone, measured. 1 shows the colours as sent.
    "terminal.integrated.minimumContrastRatio": 1,
    "cmake.cmakePath": "cube-cmake",
    "cmake.configureArgs": [
        "-DCMAKE_COMMAND=cube-cmake"
    ],
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "stm32cube-ide-clangd.path": "cube",
    "stm32cube-ide-clangd.arguments": [
        "starm-clangd",
        "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gcc*",
        "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-g++*"
    ],
    // Pylance reads code, it does not run it: the notebooks and tools put
    // host/ on sys.path at execution time, which static analysis cannot
    // see - so `import coaxial` was flagged unresolved in every notebook
    // on an interpreter without `pip install -e host/`. This tells the
    // analyzer what the runtime does.
    // The tree reads clean under Pylance in basic mode (FINDINGS, 2026-09-08):
    // the editor is asked for that mode, so a regression shows where it lands.
    "python.analysis.typeCheckingMode": "basic",
    // THE INTERPRETER IS THE ONE setup.ps1 INSTALLS INTO: python.org's,
    // through its per-user launcher. This machine also carries a uv-managed
    // CPython of the same version with none of the host's packages in it,
    // and the Python extension picked that one - so every notebook showed
    // `Import "matplotlib.pyplot" could not be resolved from source` while
    // matplotlib 3.11.1 sat in the other (2026-09-13). This setting is the
    // default for the .py files in a fresh workspace; an interpreter chosen
    // by hand outranks it. The notebooks do not depend on it: each names
    // the kernel `coaxial_63100`, which setup.ps1 registers on the python
    // it installs into (host/tools/make_notebooks.py --kernel install).
    "python.defaultInterpreterPath": "${env:LOCALAPPDATA}\\Python\\bin\\python.exe",
    "python.analysis.extraPaths": [
        "host",
        "host/tools",
        "host/tests"
    ]
}