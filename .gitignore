# ---- build output ----------------------------------------------------------
# cube-cmake writes per-preset trees here; everything in it is regenerated.
build/
out/
cmake-build-*/

# ---- CubeMX scratch --------------------------------------------------------
# .mxproject is the generator's own state and is tracked deliberately: without
# it CubeMX re-generates from scratch and loses the user-code blocks. These are
# the ones that are pure noise.
mx.scratch
*.bak
*.ioc.bak
.mxproject.old

# ---- editor / IDE ----------------------------------------------------------
# .vscode and .settings ARE tracked: the STM32 extension keeps its bundle
# manifests in .settings, and c_cpp_properties.json is what makes IntelliSense
# find the HAL. Only the per-user parts are ignored.
.vscode/*.log
.vscode/ipch/
.idea/
*.code-workspace
.cache/
compile_commands.json

# ---- Python (host/) --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build-python/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- bench output ----------------------------------------------------------
# Captures stay on the bench machine. They are one board on one bench on one
# day, and a reader cannot tell that from a file in a repo - which is the same
# reason invariant 10 keeps thresholds out. host/tools/analyze_phase_log.py
# takes a path, so nothing here needs them checked in.
*.csv
# The BOM is not a measurement log: it is the authority on what is
# fitted, and docs/HARDWARE.md points at it.
!electronics/*.csv
*.log
# Runner transcripts are the same thing in another format.
host/data/
!docs/**/*.log
scratch/

# ---- toolchain / OS --------------------------------------------------------
*.elf.map
*.su
*.gcno
*.gcda
Thumbs.db
desktop.ini
.DS_Store

# ---- generic C build artefacts -------------------------------------------
# Carried over from the .gitignore already on GitHub. Mostly redundant now
# that build/ is ignored wholesale, but kept so nothing that repo excluded
# starts appearing after this merge.
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# dbg.py's per-session I/O log - hidden, overwritten each run, never shared
host/prompt_io.tmp

# Per-run record of how many checks each suite and group last reported.
# Rewritten by every run; only ever used to say what a narrowed run skipped.
host/tests/.counts.json

# The mesh reduction cached beside the model: derived from the STL, 1 MB,
# and re-made in a second if it is missing.
# The reduced mesh, rebuilt from the STL beside it on demand.
render/models/*.samples

# The session broker says what it is serving here, and removes it on the
# way out. A stale one is handled; committing one would be a lie.
host/tools/.attitude_mount
host/tools/.session.addr
host/tools/.session.json
host/tests/.session.addr.test

# the hand-off script Claude rewrites and you run - not the project's
claude_do_it.ps1
claude_do_it.log
claude_watch.ps1
claude_watch.pid
