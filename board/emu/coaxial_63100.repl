// coaxial_63100.repl - The board's MCU as Renode models it: an STM32H753 at 475 MHz.
using "platforms/cpus/stm32h753.repl"

nvic:
    systickFrequency: 475000000

// The board's 25 MHz crystal: the model assumes 8, and the core it works out from the PLL
// then runs at 0.32 of what the firmware set (2026-09-25).
rcc:
    hseFrequency: 25000000

dwt:
    frequency: 475000000

// SPI2: Renode registers SPI4 alone; the board has both.
spi2: SPI.STM32H7_SPI @ sysbus 0x40003800
