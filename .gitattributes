# This machine has core.autocrlf on, and CubeMX writes LF. Without this, a
# clone rewrites every source to CRLF on checkout - which breaks the LF
# assumption noted in CLAUDE.md and shows the whole tree as modified after any
# CubeMX regeneration. Normalise in the repo, check out LF, and let the two
# PowerShell scripts keep CRLF because that is what the Windows host expects.
* text=auto eol=lf

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.ioc       text eol=lf
.mxproject  text eol=lf

*.elf binary
*.bin binary
*.hex binary
*.pdf binary
*.png binary
