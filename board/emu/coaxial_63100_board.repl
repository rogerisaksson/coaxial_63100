// coaxial_63100_board.repl - The board's models in place of Renode's (coaxial_63100.resc
// unregisters those): the three ADCs as Coaxial63100_ADC, their common blocks as memory, the DWT
// as FastDWT. ADC1 and ADC2 share their interrupt; ADC3's reaches the NVIC through EXTI 75.
adc1: Analog.Coaxial63100_ADC @ sysbus <0x40022000, +0x100>
    referenceVoltage: 3.3
    -> nvic@18

adc2: Analog.Coaxial63100_ADC @ sysbus <0x40022100, +0x100>
    referenceVoltage: 3.3

adc12Common: Memory.ArrayMemory @ sysbus 0x40022300
    size: 0x100

adc3: Analog.Coaxial63100_ADC @ sysbus <0x58026000, +0x100>
    referenceVoltage: 3.3
    -> exti@75

adc3Common: Memory.ArrayMemory @ sysbus 0x58026300
    size: 0x100

// The front end (Coaxial63100_AFE.cs) on AFE_ON, PB2, and the pins it drives, as board_adc.c's
// table wires them; its phase transfer is coaxial_63100_afe.repl's, from LTspice.
afe: Analog.Coaxial63100_AFE @ gpioPortB 2

gpioPortB:
    2 -> afe@0
    12 -> imu@0

phaseU: Analog.Coaxial63100_AFEChannel @ adc3 1
    afe: afe
    signal: "Phase U"

phaseV: Analog.Coaxial63100_AFEChannel @ adc1 3
    afe: afe
    signal: "Phase V"

phaseW: Analog.Coaxial63100_AFEChannel @ adc2 4
    afe: afe
    signal: "Phase W"

clevel: Analog.Coaxial63100_AFEChannel @ adc2 5
    afe: afe
    signal: "Clevel"

ntc: Analog.Coaxial63100_AFEChannel @ adc1 9
    afe: afe
    signal: "NTC"

dcBus: Analog.Coaxial63100_AFEChannel @ adc3 10
    afe: afe
    signal: "DC bus"

cinj: Analog.Coaxial63100_AFEChannel @ adc3 11
    afe: afe
    signal: "Cinj"

rail5: Analog.Coaxial63100_AFEChannel @ adc1 18
    afe: afe
    signal: "+5V"

vgate: Analog.Coaxial63100_AFEChannel @ adc1 19
    afe: afe
    signal: "Vgate"

die: Analog.Coaxial63100_AFEChannel @ adc3 18
    afe: afe
    signal: "MCU die"

// The power stage and what it turns (Coaxial63100_Plant.cs) on TIM1_CH1, PE9: idle until a
// world is given it (host/tools/emu/world.py), the front end's values its until then; it keeps
// TIM1's BDTR.
plant: Analog.Coaxial63100_Plant @ gpioPortE 9
    afe: afe
    tim1: timer1
    adc1: adc1
    adc2: adc2
    adc3: adc3
    angle: angle

// The A1335 on SPI4, its chip select PE4 (Coaxial63100_A1335.cs): the plant's shaft.
angle: Sensors.Coaxial63100_A1335 @ spi4
    afe: afe

gpioPortE:
    4 -> angle@0

// The BNO085 on SPI2 (Coaxial63100_BNO085.cs): chip select PB12, WAKE PD9 and NRSTN PD10 in,
// H_INTN out on PD8.
imu: Sensors.Coaxial63100_BNO085 @ spi2
    afe: afe
    Interrupt -> gpioPortD@8

gpioPortD:
    9 -> imu@1
    10 -> imu@2

// USART2 and UART5 behind their RS485 transceivers (RS485_Transceiver.cs), each on its DE pin
// (PA1, PC8).
transceiverA: UART.RS485_Transceiver @ gpioPortA 1
    uart: usart2

transceiverB: UART.RS485_Transceiver @ gpioPortC 8
    uart: uart5

// The console's wire (UART_Line.cs) on USART3's RX pin, PB11.
consoleLine: UART.UART_Line @ gpioPortB 11
    uart: usart3

// The cycle counter without a time sync a read, at the core's clock as the RCC sets it
// (FastDWT.cs).
dwt: Miscellaneous.FastDWT @ sysbus 0xE0001000
    clock: nvic
