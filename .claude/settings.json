{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/host/tools/dev/relay_first.py\"",
            "timeout": 10,
            "statusMessage": "Suites on the relay"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/host/tools/dev/lint.py\" --hook post",
            "timeout": 120,
            "statusMessage": "Linting the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/host/tools/dev/lint.py\" --hook stop",
            "timeout": 300,
            "statusMessage": "Linting the changed files"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/host/tools/dev/measure_first.py\"",
            "timeout": 10,
            "statusMessage": "Movement named: measure first"
          }
        ]
      }
    ]
  }
}
