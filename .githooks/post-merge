#!/bin/sh
# The repo's post-merge (setup.ps1 points git here): a pull's sources - `git pull --rebase` with
# nothing of one's own to replay is one - built into this tree's images
# (host/tools/target/current.py: each tree's ninja asked, Debug and Release built where behind),
# so no old binary is run after it; a tree that built none - a worktree - builds them here,
# never configured being behind, so the suites that read an image find one after its first pull.
# The check is run as this tree's own module, from host/, not as the installed one's. Git goes
# on whatever the build says. post-rewrite runs this too, post-checkout where an image was built.
[ -f host/tools/target/current.py ] || exit 0
cd host && python -X utf8 -m tools.target.current
exit 0
